from __future__ import print_function
import argparse
import torch
import torch.nn as nn
import torch.nn.functional as F
import torch.optim as optim
from torchvision import datasets, transforms
import numpy as np
import logging
import os
from torch.utils.data import Dataset, DataLoader
from torch.nn import Linear, ReLU

# Logger setup
def get_logger(filename, verbosity=1, name=None):
    level_dict = {0: logging.DEBUG, 1: logging.INFO, 2: logging.WARNING}
    formatter = logging.Formatter("[%(asctime)s][%(filename)s][line:%(lineno)d][%(levelname)s]%(message)s")
    logger = logging.getLogger(name)
    logger.setLevel(level_dict[verbosity])
    fh = logging.FileHandler(filename, "w")
    fh.setFormatter(formatter)
    logger.addHandler(fh)
    sh = logging.StreamHandler()
    sh.setFormatter(formatter)
    logger.addHandler(sh)
    return logger

# Custom Dataset class
class MechMNISTDataset(Dataset):
    def __init__(self, root_dir, train=True, train_set=[], transform=None):
        self.data = np.load(os.path.join(root_dir, 'img_arrays_15000.npy'))
        targets = np.load(os.path.join(root_dir, 'disp_15000.npy'))
        self.data = self.data.reshape((-1, 25, 25))[train_set]
        self.targets = targets.reshape(-1, 3 * 25 * 25).astype(float)[train_set]
        self.transform = transform
    
    def __len__(self):
        return len(self.data)
    
    def __getitem__(self, idx):
        img = self.data[idx]
        lab = self.targets[idx]
        if self.transform:
            img = self.transform(img)
        return img, lab

# Neural Network Model
class Net(nn.Module):
    def __init__(self):
        super(Net, self).__init__()
        self.fc1 = Linear(25*25, 1568*4)
        self.fc2 = Linear(1568*4, 1568)
        self.fc3 = Linear(1568, 784)
        self.fc4 = Linear(784, 3*25*25)
    
    def forward(self, x):
        x = x.view(x.shape[0], -1)
        x = F.relu(self.fc1(x))
        x = F.relu(self.fc2(x))
        x = F.relu(self.fc3(x))
        x = self.fc4(x)
        return x

# Training function
def train(args, model, device, train_loader, optimizer):
    model.train()
    loss_fcn = nn.L1Loss()
    for batch_idx, (data, target) in enumerate(train_loader):
        data, target = data.to(device), target.to(device)
        optimizer.zero_grad()
        output = model(data)
        loss = loss_fcn(output, target.float())
        loss.backward()
        optimizer.step()
        if batch_idx % args.log_interval == 0:
            print(f'Train Epoch: {batch_idx}/{len(train_loader)}\tLoss: {loss.item():.4f}')

# Testing function
def test(model, device, test_loader, logger):
    model.eval()
    loss_fcn = nn.L1Loss()
    test_loss, MAE, counter = 0, 0, 0
    with torch.no_grad():
        for data, target in test_loader:
            data, target = data.to(device), target.to(device)
            output = model(data)
            test_loss += loss_fcn(output, target.float()).item()
            MAE += abs(target.cpu().numpy()[0][0] - output.cpu().numpy()[0][0])
            counter += 1
    logger.info(f'Average loss: {test_loss / counter:.4f}, MAE: {MAE / counter:.4f}')

# Main execution
def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--batch-size', type=int, default=60)
    parser.add_argument('--epochs', type=int, default=200)
    parser.add_argument('--lr', type=float, default=0.005)
    parser.add_argument('--log-interval', type=int, default=100)
    args = parser.parse_args()
    
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    train_set, test_set = range(12000), range(12000, 14494)
    dataset_dir = "./dataset_path"  # Update with actual dataset path
    
    train_loader = DataLoader(MechMNISTDataset(dataset_dir, train=True, train_set=train_set,
                                transform=transforms.ToTensor()), batch_size=args.batch_size, shuffle=True)
    test_loader = DataLoader(MechMNISTDataset(dataset_dir, train=False, train_set=test_set,
                               transform=transforms.ToTensor()), batch_size=args.batch_size, shuffle=False)
    
    model = Net().to(device)
    optimizer = optim.Adam(model.parameters(), lr=args.lr)
    logger = get_logger("training.log")
    
    for epoch in range(1, args.epochs + 1):
        train(args, model, device, train_loader, optimizer)
        test(model, device, test_loader, logger)
    
    torch.save(model.state_dict(), "model.pth")

if __name__ == '__main__':
    main()
